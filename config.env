# Proxmox VE API 地址，填写到主机和端口，例如 https://192.168.1.10:8006
PVE_HOST=https://192.168.50.252:8006

# API Token ID 格式：用户@认证域!Token名称，例如 root@pam!pve-tools
PVE_TOKEN_ID=root@pam!test
PVE_TOKEN_SECRET=6d8a02a3-dcfa-46a7-b938-5da14accf7b8

# 使用自签名证书时可设为 false；生产环境建议保持 true 并正确配置证书
PVE_TLS_VERIFY=false
PVE_REQUEST_TIMEOUT=15